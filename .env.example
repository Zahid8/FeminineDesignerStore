DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_CSRF_TRUSTED_ORIGINS=

# Media storage — set to "s3" for production object storage, "local" (default) for filesystem.
DJANGO_MEDIA_STORAGE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# Razorpay payment gateway (optional — manual UPI used when unset)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-site>/razorpay/webhook/, events payment.captured,
# order.paid, payment.failed; paste the same secret here.
# RAZORPAY_WEBHOOK_SECRET=
# Unpaid online orders are cancelled and their stock released after (minutes):
# UNPAID_ORDER_RELEASE_MINUTES=60

# Google sign-in: Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application);
# Authorized JavaScript origins: https://<your-site>. Empty = Google button hidden.
# GOOGLE_CLIENT_ID=

# Email — console backend is used when DJANGO_EMAIL_HOST is unset.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=FemDes <orders@example.com>
# STORE_NOTIFY_EMAIL=owner@example.com

# Phone OTP login — console SMS backend prints codes in development.
# PHONE_LOGIN_COUNTRIES=IN
# India (DLT): MSG91 — create an OTP template containing ##OTP## on MSG91 (DLT-approved), then:
# SMS_BACKEND=store.sms.Msg91OtpBackend
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# …or 2Factor.in:
# SMS_BACKEND=store.sms.TwoFactorOtpBackend
# TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE=
# …or Twilio:
# SMS_BACKEND=store.sms.TwilioSmsBackend
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Behind a hosting proxy (Render/Railway/Fly.io/nginx) use the forwarded client IP:
# CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR
# CLIENT_IP_TRUSTED_PROXIES=1
# Public origin for links in background emails (no trailing slash):
# SITE_URL=https://www.example.com
# API token used by the Feminine Designer billing app (Online Orders page). Empty = API disabled.
# WEBSTORE_API_TOKEN=
# Billing app bill links: same values as the billing app (Feminine Designer) so
# customers can download the identical PDF bill. Leave empty to offer print-to-PDF instead.
# BILLING_APP_URL=https://your-billing-app.vercel.app
# BILL_LINK_SECRET=
